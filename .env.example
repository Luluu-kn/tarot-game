# 大模型 API 配置
# 复制本文件为 .env 后填入真实 API Key

# LLM API Key（必填）
# Deepseek 获取地址：https://platform.deepseek.com/
# 智谱 GLM 获取地址：https://open.bigmodel.cn/
LLM_API_KEY=your_api_key_here

# 大模型接口地址（选填，默认 Deepseek）
# Deepseek 示例：https://api.deepseek.com/v1/chat/completions
# 智谱 GLM 示例：https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# 模型名称（选填）
# Deepseek 示例：deepseek-chat
# 智谱 GLM 示例：glm-4
LLM_MODEL=deepseek-chat

# 本地兜底开关（选填）
# 当未配置 API Key 或调用失败时，自动使用内置模板生成治愈文案，保证前端交互跑通
# 设为 false 可强制只使用真实大模型
LOCAL_FALLBACK_ENABLED=true
